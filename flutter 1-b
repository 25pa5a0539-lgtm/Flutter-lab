void main() {
  // Variables
  String name = "John";
  int age = 20;
  double marks = 85.5;
  bool passed = true;

  // Display output
  print("Name: $name");
  print("Age: $age");
  print("Marks: $marks");
  print("Passed: $passed");

  // Conditional statement
  if (marks >= 50) {
    print("Result: Pass");
  } else {
    print("Result: Fail");
  }

  // Loop
  print("Numbers from 1 to 5:");
  for (int i = 1; i <= 5; i++) {
    print(i);
  }

  // Function call
  print("Sum = ${add(10, 20)}");
}

// Function
int add(int a, int b) {
  return a + b;
}
